{
  "name": "sawb",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "demo": "npm run build -w @sawb/admin && npm run start -w @sawb/server",
    "server": "npm run dev -w @sawb/server",
    "admin": "npm run dev -w @sawb/admin",
    "mobile": "npm run start -w mobile",
    "test": "npm test -w @sawb/shared && npm test -w @sawb/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "import:stations": "node scripts/import-stations.mjs"
  }
}
